# Kopiere diese Datei nach .env und trage eigene Werte ein.
# Zufallswerte erzeugen (PowerShell):  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
# Zufallswerte erzeugen (Linux-Server):  openssl rand -hex 32
# Vor dem Go-Live bzw. nach Änderungen auf dem Server prüfen:  pnpm live:pruefen
DATABASE_URL=postgresql://bsv:bsv@127.0.0.1:5432/bsv
PAYLOAD_SECRET=bitte-ersetzen-mindestens-32-zeichen
# Verschlüsselt IBANs, 2FA-Geheimnisse und die Sicherungen. NIE ÄNDERN und getrennt aufbewahren (Passwortmanager des Vorstands) –
# ohne ihn sind gespeicherte IBANs und alle Sicherungen unlesbar.
ENCRYPTION_KEY=bitte-ersetzen-mindestens-32-zeichen-NIE-AENDERN-sonst-sind-IBANs-unlesbar
# Nur während eines Schlüsselwechsels (pnpm schluessel:wechseln, siehe deploy/README.md): der BISHERIGE Schlüssel.
# Danach wieder löschen.
# ENCRYPTION_KEY_ALT=
PREVIEW_SECRET=bitte-ersetzen-mindestens-24-zeichen
# Live: exakt die Adresse der Website mit https:// und ohne / am Ende, z. B. https://www.buedericher-spielverein.de
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Keine Nutzungsdaten an Next.js senden
NEXT_TELEMETRY_DISABLED=1
# E-Mail-Versand (Pflicht für die Live-Website: Registrierung, „Passwort vergessen“, Benachrichtigungen)
# Ohne SMTP_HOST stehen die Mails beim Entwickeln nur im Server-Fenster. Anleitung: deploy/README.md → „E-Mail-Versand“
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=BSV 1919
# Tägliche automatische Sicherung auf der Live-Website (Standard: an). Nur zum Testen abschaltbar:
# BSV_SICHERUNG=aus
# Zwei-Faktor-Anmeldung für die Verwaltung. Nur lokal zum Entwickeln abschaltbar – auf der Live-Website startet die Website damit nicht:
# ZWEI_FAKTOR=aus
